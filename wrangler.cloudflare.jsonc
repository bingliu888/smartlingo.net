{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smartlingo-net",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "limits": { "cpu_ms": 1000 },
  "triggers": { "crons": ["*/5 * * * *"] },
  "routes": [
    {
      "pattern": "smartlingo.net",
      "custom_domain": true
    },
    {
      "pattern": "www.smartlingo.net",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuc21hcnRsaW5nby5uZXQk",
    "GITHUB_REPOSITORY_URL": "https://github.com/bingliu888/smartlingo.net",
    "SITE_URL": "https://smartlingo.net",
    "CLOUDFLARE_ACCOUNT_ID": "7222b9842bcee7196ba3aca03d45f4b7",
    "REALTIMEKIT_APP_ID": "816eb53a-1dc8-4939-9716-500747e385db",
    "REALTIMEKIT_VOICE_PRESET": "group_call_participant",
    "REALTIMEKIT_VIDEO_PRESET": "group_call_participant",
    "REALTIMEKIT_GUEST_PRESET": "group_call_guest",
    "REALTIMEKIT_GUEST_AUDIO_PRESET": "group_call_guest",
    "REALTIMEKIT_MEMBER_PRESET": "group_call_participant",
    "REALTIMEKIT_MEMBER_AUDIO_PRESET": "group_call_participant",
    "REALTIMEKIT_HOST_PRESET": "group_call_host",
    "REALTIMEKIT_HOST_AUDIO_PRESET": "group_call_host",
    "REALTIMEKIT_VIEWER_PRESET": "group_call_guest",
    "REALTIMEKIT_VIEWER_AUDIO_PRESET": "group_call_guest",
    "REALTIMEKIT_WEBINAR_HOST_PRESET": "webinar_presenter",
    "REALTIMEKIT_WEBINAR_SPEAKER_PRESET": "webinar_presenter",
    "REALTIMEKIT_WEBINAR_VIEWER_PRESET": "webinar_viewer",
    "REALTIMEKIT_LIVESTREAM_HOST_PRESET": "livestream_host",
    "REALTIMEKIT_LIVESTREAM_SPEAKER_PRESET": "livestream_host",
    "REALTIMEKIT_LIVESTREAM_VIEWER_PRESET": "livestream_viewer"
  },
  "no_bundle": true,
  "find_additional_modules": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smartlingo-net-cutover-20260801-d1",
      "database_id": "24bb39db-d747-4cd2-8ff4-cb2246660343",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "smartlingo-net-cutover-20260801-media"
    },
    {
      "binding": "CLASS_FILES",
      "bucket_name": "smartlingo-net-class-files"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
