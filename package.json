{
  "name": "smartlingo-net",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "contracts:compile": "node scripts/compile-smartpay.mjs",
    "contracts:test": "npm run contracts:compile && node --test tests/smartpay-contract.test.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "scan:sensitive": "node scripts/scan-sensitive-data.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "db:validate": "node scripts/validate-d1-migrations.mjs",
    "validate:layout": "node scripts/verify-runtime-layout-release.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.13.0",
    "@clerk/localizations": "4.13.7",
    "@clerk/nextjs": "^7.6.0",
    "@cloudflare/realtimekit": "2.0.2",
    "@cloudflare/realtimekit-react": "2.0.2",
    "@cloudflare/realtimekit-react-ui": "2.0.2",
    "@openzeppelin/contracts": "^5.6.1",
    "drizzle-orm": "0.45.2",
    "hls.js": "^1.5.17",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "next": "16.3.3",
    "pdfjs-dist": "^5.5.207",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.55.19",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.0",
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/tx": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "solc": "^0.8.36",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.126.0"
  },
  "overrides": {
    "browserslist": "4.28.8",
    "esbuild": "0.28.2",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "type": "module",
  "displayName": "SmartLingo.net"
}
